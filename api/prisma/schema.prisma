generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum BookingRequestStatus {
  PENDING
  BOOKED
  CANCELLED
  EXPIRED
  CLOSED
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum CalendarConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  NEEDS_RECONNECT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SyncIssueStatus {
  OPEN
  RESOLVED
}

enum ActorType {
  ADMIN
  SYSTEM
  PUBLIC
}

model Artist {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  displayName         String               @map("display_name") @db.VarChar(120)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  studioSettings      StudioSettings?
  weeklyAvailability  WeeklyAvailability[]
  availabilityBlocks  AvailabilityBlock[]
  bookingRequests     BookingRequest[]
  appointments        Appointment[]
  calendarConnection  CalendarConnection?
  calendarOauthStates CalendarOAuthState[]
  adminSessions       AdminSession[]

  @@map("artists")
}

model StudioSettings {
  id                 String @id @default(uuid()) @db.Uuid
  artistId           String @unique @map("artist_id") @db.Uuid
  timezone           String @db.VarChar(64)
  slotStepMinutes    Int    @default(30) @map("slot_step_minutes")
  bufferMinutes      Int    @default(0) @map("buffer_minutes")
  minimumNoticeHours Int    @default(0) @map("minimum_notice_hours")
  horizonDays        Int    @default(60) @map("horizon_days")
  artist             Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@map("studio_settings")
}

model WeeklyAvailability {
  id         String   @id @default(uuid()) @db.Uuid
  artistId   String   @map("artist_id") @db.Uuid
  weekday    Int
  startLocal DateTime @map("start_local") @db.Time(6)
  endLocal   DateTime @map("end_local") @db.Time(6)
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, weekday])
  @@map("weekly_availability")
}

model AvailabilityBlock {
  id       String   @id @default(uuid()) @db.Uuid
  artistId String   @map("artist_id") @db.Uuid
  startAt  DateTime @map("start_at") @db.Timestamptz(6)
  endAt    DateTime @map("end_at") @db.Timestamptz(6)
  reason   String?  @db.VarChar(240)
  artist   Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, startAt, endAt])
  @@map("availability_blocks")
}

model Client {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(120)
  email           String?          @db.VarChar(320)
  phone           String?          @db.VarChar(32)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  bookingRequests BookingRequest[]

  @@map("clients")
}

model BookingRequest {
  id                String               @id @default(uuid()) @db.Uuid
  artistId          String               @map("artist_id") @db.Uuid
  clientId          String               @map("client_id") @db.Uuid
  depositVerifiedAt DateTime?            @map("deposit_verified_at") @db.Timestamptz(6)
  depositVerifiedBy String?              @map("deposit_verified_by") @db.Uuid
  durationMinutes   Int                  @map("duration_minutes")
  status            BookingRequestStatus @default(PENDING)
  minDate           DateTime?            @map("min_date") @db.Date
  maxDate           DateTime?            @map("max_date") @db.Date
  allowedWeekdays   Json?                @map("allowed_weekdays")
  allowedWindows    Json?                @map("allowed_windows")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  version           Int                  @default(1)
  artist            Artist               @relation(fields: [artistId], references: [id], onDelete: Restrict)
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tokens            BookingToken[]
  appointment       Appointment?

  @@index([artistId, status])
  @@map("booking_requests")
}

model BookingToken {
  id         String         @id @default(uuid()) @db.Uuid
  requestId  String         @map("request_id") @db.Uuid
  tokenHash  String         @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(6)
  consumedAt DateTime?      @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  request    BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, expiresAt])
  @@map("booking_tokens")
}

model Appointment {
  id            String            @id @default(uuid()) @db.Uuid
  requestId     String            @unique @map("request_id") @db.Uuid
  artistId      String            @map("artist_id") @db.Uuid
  startAt       DateTime          @map("start_at") @db.Timestamptz(6)
  endAt         DateTime          @map("end_at") @db.Timestamptz(6)
  status        AppointmentStatus @default(CONFIRMED)
  syncStatus    SyncStatus        @default(PENDING) @map("sync_status")
  version       Int               @default(1)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  request       BookingRequest    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  artist        Artist            @relation(fields: [artistId], references: [id], onDelete: Restrict)
  calendarEvent CalendarEvent?
  syncIssues    SyncIssue[]

  @@index([artistId, startAt])
  @@map("appointments")
}

model CalendarConnection {
  id                    String                   @id @default(uuid()) @db.Uuid
  artistId              String                   @unique @map("artist_id") @db.Uuid
  calendarId            String                   @map("calendar_id") @db.VarChar(320)
  calendarName          String?                  @map("calendar_name") @db.VarChar(200)
  encryptedRefreshToken String                   @map("encrypted_refresh_token") @db.Text
  status                CalendarConnectionStatus @default(DISCONNECTED)
  connectedAt           DateTime?                @map("connected_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  artist                Artist                   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@map("calendar_connections")
}

model CalendarOAuthState {
  id         String    @id @default(uuid()) @db.Uuid
  artistId   String    @map("artist_id") @db.Uuid
  stateHash  String    @unique @map("state_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  artist     Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, expiresAt])
  @@map("calendar_oauth_states")
}

model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  artistId   String    @map("artist_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  artist     Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, expiresAt])
  @@map("admin_sessions")
}

model CalendarEvent {
  id              String      @id @default(uuid()) @db.Uuid
  appointmentId   String      @unique @map("appointment_id") @db.Uuid
  calendarId      String      @map("calendar_id") @db.VarChar(320)
  externalEventId String      @unique @map("external_event_id") @db.VarChar(320)
  etag            String?     @db.VarChar(320)
  lastSyncedAt    DateTime?   @map("last_synced_at") @db.Timestamptz(6)
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateId   String       @map("aggregate_id") @db.Uuid
  type          String       @db.VarChar(120)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime?    @map("next_attempt_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model SyncIssue {
  id            String          @id @default(uuid()) @db.Uuid
  appointmentId String          @map("appointment_id") @db.Uuid
  operation     String          @db.VarChar(32)
  code          String          @db.VarChar(64)
  messageSafe   String          @map("message_safe") @db.VarChar(500)
  status        SyncIssueStatus @default(OPEN)
  lastAttemptAt DateTime?       @map("last_attempt_at") @db.Timestamptz(6)
  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, lastAttemptAt])
  @@map("sync_issues")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  entityType String    @map("entity_type") @db.VarChar(80)
  entityId   String    @map("entity_id") @db.Uuid
  action     String    @db.VarChar(80)
  changes    Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  keyHash      String   @map("key_hash") @db.VarChar(128)
  scope        String   @db.VarChar(160)
  requestHash  String   @map("request_hash") @db.VarChar(128)
  responseCode Int      @map("response_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([scope, keyHash])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
